# Server Port (default: 3001)
PORT=3001

# Node Environment
NODE_ENV=production

# SQLite database path (default: ./database.sqlite)
DB_PATH=./database.sqlite

# Persistent uploaded audio storage folder (default: ./uploads)
UPLOADS_DIR=./uploads

# Jamendo Music API Configuration
# Register for a free application Client ID at https://developer.jamendo.com
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# MusicDownloadAgent Configuration
# Timeout for browser automation and audio chunk download in milliseconds (default: 90000)
AGENT_DOWNLOAD_TIMEOUT_MS=90000
# Isolated directory for temporary download chunks (default: ./uploads/.agent_temp)
AGENT_TEMP_DIR=./uploads/.agent_temp
# Optional custom path to Chrome or Edge executable (defaults to auto-detection on Windows)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

